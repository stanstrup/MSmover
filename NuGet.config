<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-local package sources. The machine-level NuGet config on the development box has no
  sources configured, so this keeps the build self-describing without changing global state.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
