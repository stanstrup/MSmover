{
  "metadata": [
    {
      "src": [
        {
          "src": "../src/MSmover.Core",
          "files": [ "MSmover.Core.csproj" ]
        }
      ],
      "dest": "api",
      "namespaceLayout": "nested",
      "memberLayout": "samePage",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "**/*.{md,yml}" ],
        "exclude": [ "_site/**", "obj/**" ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ],
        "exclude": [ "_site/**", "obj/**" ]
      }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "postProcessors": [ "ExtractSearchIndex" ],
    "globalMetadata": {
      "_appName": "MSmover",
      "_appTitle": "MSmover",
      "_appFooter": "MSmover &mdash; verified transfer of LC-MS raw data. MIT licensed.",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/stanstrup/MSmover",
        "branch": "main"
      },
      "pdf": false
    }
  }
}
